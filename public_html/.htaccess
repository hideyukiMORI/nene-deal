# Serve the SPA and the API from the same origin.
# Order: API/infra routes → real files → SPA fallback → front controller.
DirectoryIndex index.html index.php
RewriteEngine On

# API and infra routes always go to the front controller.
# demo/ is the disposable-demo start route (#69) — a backend route, not an SPA page.
RewriteRule ^(api/|health$|machine/|demo/) index.php [QSA,L]

# Existing files and directories are served as-is (SPA assets, openapi.php).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback when the built frontend is deployed into this directory
# (production). In development no index.html exists here and everything
# falls through to the front controller, as before.
RewriteCond %{DOCUMENT_ROOT}/index.html -f
RewriteRule ^ index.html [L]

RewriteRule ^ index.php [QSA,L]
