# Serve the SPA and the API from the same origin.
# Order: API/infra routes → real files → SPA fallback → front controller.
#
# `index.php` is the ONLY directory index — index.html is deliberately excluded.
# The release build layers the Vite `index.html` into this document root
# (tools/build-release.sh), so listing it here would make Apache serve the bare
# `/` statically and skip PHP — exactly where the disposable-demo seat page lands
# (DemoSessionSeater's `location.replace('/')`), silently dropping the env-gated
# analytics injection (#114). Routing `/` through index.php instead lets
# SpaShellFallback serve the same shell *through* PHP (matching siblings, whose
# shells live outside the doc root — NeNe Clear `assets/index.html`, NeNe Invoice
# `admin/index.html` — so their `/` already resolves to index.php). On non-demo
# installs the shell is emitted byte-for-byte and PHP sets no CSP, so the static
# and PHP-served bodies are identical and the `.htaccess` default CSP still applies.
DirectoryIndex index.php
RewriteEngine On

# Some CGI/FastCGI shared hosts have Apache itself drop the Authorization
# header; re-deliver it as an env var so PHP still sees it. Hosts whose *front
# proxy* strips the header (e.g. HETEML) are covered separately by the SPA's
# X-Authorization mirror, received by NENE2's opt-in
# AuthorizationHeaderFallbackMiddleware (NENE2 #1558 / ADR 0019, enabled via
# RuntimeServiceProvider's `enableAuthorizationHeaderFallback: true`)
# (#67/#68/#83/#101/#130).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# API and infra routes always go to the front controller.
# demo/ is the disposable-demo start route (#69) — a backend route, not an SPA page.
RewriteRule ^(api/|health$|machine/|demo/) index.php [QSA,L]

# Existing files and directories are served as-is (SPA assets, openapi.php).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else — including SPA navigations — goes to the front controller.
# The built index.html shell is served *through* index.php (SpaShellFallback),
# not statically, so the disposable-demo host can inject its env-gated cookieless
# analytics beacon (#112) without baking it into the committed build. On every
# other install the shell is emitted byte-for-byte. In development no index.html
# exists here and requests still fall through to the front controller, as before.
RewriteRule ^ index.php [QSA,L]

# Hardening (Apache + mod_headers, invoice shape — #101). `always` covers both
# statically served SPA assets and PHP-generated responses (API + SPA shell).
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header unset X-Powered-By
    # HSTS only takes effect over HTTPS; harmless over plain HTTP.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"

    # CSP tuned to the deal SPA: external module scripts only (script-src 'self'),
    # dynamic inline style attributes need 'unsafe-inline', and the SPA shell
    # loads Google Fonts (fonts.googleapis.com CSS + fonts.gstatic.com woff2).
    #
    # The disposable-demo routes (/demo/…) are EXCLUDED: the seat page ships its
    # own page-specific CSP with a per-response script nonce (DemoSessionSeater),
    # and the demo error pages use inline script/style. A second, stricter CSP
    # from this layer would intersect with the page CSP and block the nonce'd
    # seat script, breaking the public demo. The condition uses THE_REQUEST
    # (the original request line), which — unlike SetEnvIf/Request_URI vars —
    # survives the mod_rewrite internal redirect to index.php (verified against
    # the compose.prod.yaml stack).
    #
    # The added `-z resp('Content-Security-Policy')` guard makes this default
    # yield whenever the response already carries a CSP set by PHP. Only the
    # disposable-demo SPA shell does that (env-gated cookieless analytics, #112):
    # there DemoAnalyticsInjection emits a CSP widened for the analytics origin,
    # and this line must not clobber it into two intersecting CSPs. Every other
    # response (static assets, JSON API, and the SPA shell on non-demo installs,
    # none of which set a CSP) is unchanged — the expr is true and the default
    # CSP below is applied exactly as before.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" "expr=%{THE_REQUEST} !~ m#^\S+ /demo/# && -z resp('Content-Security-Policy')"
</IfModule>
ServerSignature Off
