# App config for the disposable assessment stack. Copy to `.env.app` and set a
# JWT secret. Throwaway values — never production.
APP_ENV=local
# Production-shaped error rendering: confirm no SQL/stack/path leaks with debug off.
APP_DEBUG=false
APP_NAME="NeNe Deal (sectest)"
PROBLEM_DETAILS_BASE_URL=https://nene-deal.dev/problems/

# MySQL service in docker-compose.yml.
DB_ADAPTER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=nene_deal
DB_USER=nene
DB_PASSWORD=nene_pw
DB_CHARSET=utf8mb4

# Operator JWT (HS256). Set an explicit secret so `mint.php` and the app share
# it (needed for the JWT-forgery tests). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
NENE2_LOCAL_JWT_SECRET=

# Leave the machine API key empty: mutations are then gated by the operator JWT
# only (default self-host posture). Set to also require X-NENE2-API-Key.
NENE_DEAL_API_KEY=

# Won -> Invoice handoff points at a local stub (see run.sh); never a real host.
NENE_DEAL_INVOICE_BASE_URL=
NENE_DEAL_INVOICE_BEARER_TOKEN=
