# Production-shaped image: PHP 8.4 + Apache serving the API front controller
# and the built SPA from the same origin (public_html docroot). Built by
# compose.prod.yaml — the dev stack (compose.yaml) keeps using ./Dockerfile
# with a bind mount.
#
# Fail-close by design: APP_ENV=production, APP_DEBUG=false, and the
# entrypoint refuses to boot without NENE2_LOCAL_JWT_SECRET.

# ---- Stage 1: SPA build --------------------------------------------------
FROM node:22-alpine AS frontend

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci
COPY frontend/ ./

# The backend enforces operator JWT in production, so the SPA must gate on
# login. Baked in at build time (Vite env).
ENV VITE_REQUIRE_LOGIN=true
RUN npm run build

# ---- Stage 2: PHP runtime + vendor (no-dev) + application ----------------
FROM php:8.4-apache

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && docker-php-ext-install pdo_mysql opcache \
    && rm -rf /var/lib/apt/lists/* \
    # Expose the real container environment to $_ENV (NENE2 ConfigLoader reads
    # $_ENV/$_SERVER); hide PHP/Apache version details in production.
    && printf 'variables_order=EGPCS\nexpose_php=0\ndisplay_errors=0\nlog_errors=1\n' > /usr/local/etc/php/conf.d/zz-nene-deal.ini \
    && a2enmod rewrite headers \
    && printf '<Directory /var/www/html/public_html>\n    AllowOverride All\n    Require all granted\n</Directory>\nServerTokens Prod\nServerSignature Off\n' > /etc/apache2/conf-available/nene-deal.conf \
    && a2enconf nene-deal \
    && sed -ri -e 's!/var/www/html!/var/www/html/public_html!g' /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!/var/www/html/public_html!g' /etc/apache2/apache2.conf

WORKDIR /var/www/html

# Vendor first so the layer caches across source-only changes. Runtime-only:
# dev tooling (phpunit/phpstan/cs-fixer) never ships; phinx is a runtime
# dependency because migrations run on the deployed box.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts \
    && composer clear-cache

# Application source (only what the runtime needs).
COPY phinx.php ./
COPY public_html/ public_html/
COPY src/ src/
COPY database/ database/
COPY tools/ tools/
COPY docs/openapi/ docs/openapi/

# Built SPA into the docroot (same-origin serving; see public_html/.htaccess).
COPY --from=frontend /build/dist/ public_html/
RUN rm -f public_html/mockServiceWorker.js

COPY docker/php/entrypoint-prod.sh /usr/local/bin/entrypoint-prod.sh
RUN chmod +x /usr/local/bin/entrypoint-prod.sh

ENV APP_ENV=production \
    APP_DEBUG=false

ENTRYPOINT ["entrypoint-prod.sh"]
CMD ["apache2-foreground"]
