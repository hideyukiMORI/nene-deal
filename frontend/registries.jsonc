    {
      "kind": "legacy-manifest",
      "id": "nene-deal-legacy-src-app-design-styles-css",
      "repo": "nene-deal",
      "path": "src/app/design/styles.css",
      // This file was 1725 lines — 29 OVER the old 1696 cap — and nothing
      // caught it, because `nene2-check init --check` does not enforce
      // legacy-manifest maxLines/maxBytes at all (positive control: padded to
      // 1914 lines, 218 over, still exits green). Reported to fleet-tooling
      // 2026-07-29, who reproduced it independently and filed their #176.
      // The A family drain left it at 1714 (still over), so the cap was held
      // at 1696 rather than raised to bless the overshoot. B family wave 1
      // brings it to 1656 — back UNDER the original cap — so the cap now moves
      // down to the measured value as a normal shrink. Note the ratchet is
      // still not enforced upstream (fleet #180 implements it but is not
      // published yet), so this number is maintained by hand.
      // Values are formattedLineCount per fleet #176②' — NOT raw `wc -l`. Do
      // not substitute wc -l: raw carries blank lines and pre-format layout,
      // a ~2% slack that would be frozen into the cap once enforcement lands.
      // Reproduce with prettier.format(source, {parser:'css'}) then count
      // non-empty lines; maxBytes stays the unformatted source byte length.
      // B family wave 2 (.col-head .col-name / .count): 1605 / 37160.
      // C family wave 1 (timeline drain + 4 dead rules):  1548 / 36119.
      // D family wave 2a (dead .sidebar / .sidebar-foot): 1532 / 35756.
      // D family wave 2b (.deal .acct):                    1528 / 35691.
      // Supply PR (#169): the :root/[data-theme='dark'] and [data-theme='light']
      // token blocks moved to themes/calm-skin.css. `color-scheme` could not go
      // with them (not a custom property — themes-token-only), so it stayed as
      // one `color-scheme: var(--color-scheme)` line on the base :root:
      //                                                   1463 / 33007.
      "maxLines": 1463,
      "maxBytes": 33007,
    },
    {
      "kind": "lint-baseline",
      "id": "nene-deal-lb-color-no-hex-src-app-design-styles-css",
      "repo": "nene-deal",
      "rule": "color-no-hex",
      "file": "src/app/design/styles.css",
      "frozenCount": 0,
      "initializedBy": "init --scan",
      "shrunkBy": "C5 W3 #169: the only two hex literals were the `#000` stops of the .auth-brand .grid-deco mask gradients; rewritten as oklch(0% 0 0) (same computed color, same alpha). init --check verified live 2→0.",
    },
    {
      "kind": "lint-baseline",
      "id": "nene-deal-lb-declaration-no-important-src-app-design-styles-css",
      "repo": "nene-deal",
      "rule": "declaration-no-important",
      "file": "src/app/design/styles.css",
      "frozenCount": 0,
      "initializedBy": "init --scan",
      "shrunkBy": "C5 W3 #169: the sole !important (.col.drop-ok { opacity }) had no cascade to win — the 0.6 drag dim is already scoped `:not(.drop-ok)`. Dropped the flag, kept the declaration. init --check verified live 1→0.",
    },
    // The two nene2/data-theme-selector-location lint-baselines (designs.css 4 /
    // styles.css 2 — the "tail of 6") are GONE, not shrunk: the blocks they
    // grandfathered were moved into src/shared/ui/theme/themes/calm-skin.css,
    // where the rule does not apply because that is where [data-theme] belongs
    // (会議R2⑥). A baseline entry records a violation we are tolerating; once
    // the violation is structurally impossible the entry has to go, otherwise
    // the ledger keeps claiming debt that no longer exists.
    //
    // The two composite selectors below are the reason the move is not enough on
    // its own: inside a theme file, themes-token-only only accepts the bare
    // `[data-theme='x']` shape by default, so `[data-design='calm'][data-theme=…]`
    // would be rejected there. Registering them as scoped-theme/local bakes them
    // into the synthesised config's additionalScopeSelectors (#159).
    {
      "kind": "scoped-theme",
      "id": "nene-deal-scoped-theme-calm-dark",
      "repo": "nene-deal",
      "variant": "local",
      // Must match the CSS byte for byte (quote style and spacing included) —
      // the synthesiser compares selector strings, not parsed selectors.
      "selector": "[data-design='calm'][data-theme='dark']",
      "reasonRef": "nene-deal#169 — C5 W3: the calm skin's accent/surface tokens are per design × mode, so the scope is data-design × data-theme rather than data-theme alone. data-design is hard-coded to 'calm' (index.html + shared/theme/index.ts) and there is no switcher, so this is a single-skin scope, not a theme matrix.",
    },
    {
      "kind": "scoped-theme",
      "id": "nene-deal-scoped-theme-calm-light",
      "repo": "nene-deal",
      "variant": "local",
      "selector": "[data-design='calm'][data-theme='light']",
      "reasonRef": "nene-deal#169 — C5 W3: light half of the pair above. Retires with the calm skin when the C5 drain removes the last legacy rule reading these token names.",
    },
  ],
}
