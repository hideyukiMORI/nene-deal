APP_ENV=local
APP_DEBUG=false
APP_NAME="NeNe Deal"
PROBLEM_DETAILS_BASE_URL=https://nene-deal.dev/problems/

# --- Local dev ports (fixed, family-unique — AGENTS.md "Local dev ports") ---
# NeNe Deal owns the 81** block. Defaults live in compose.yaml; override here
# only to resolve a host-specific clash. Vite (5187) / Storybook (6106) are
# fixed in frontend/ config, not env.
NENE_DEAL_PORT=8110
NENE_DEAL_DB_PORT=3310

# --- Authentication ---
# Machine API key gating mutating requests (POST/PATCH/PUT/DELETE) via the
# X-NENE2-API-Key header. Leave empty in local dev to keep the API open.
# Secrets must never be committed.
NENE_DEAL_API_KEY=

# Operator login (JWT, HS256). When set, every route except /health, / and
# POST /api/v1/auth/login requires a valid `Authorization: Bearer <token>`
# from the login endpoint. Leave empty in dev to keep routes open.
# Seeded operator: operator@nene-deal.test / password.
NENE2_LOCAL_JWT_SECRET=

# Opt-in to the built-in development JWT secret when NENE2_LOCAL_JWT_SECRET is
# unset. local/dev only: production always ignores this and requires its own
# secret. Set to 1 to let login work locally without configuring a secret.
NENE2_ALLOW_DEV_SECRET=1

# Opt-in dev seed (#109): set to 1 so `phinx migrate` seeds the well-known
# local account operator@nene-deal.test / password (the dev compose stack sets
# this for you). NEVER set on a reachable box — without it no known
# credentials are ever seeded. Manual installs create their first admin with
# `php tools/create-admin.php` (the browser installer does it in the wizard).
# NENE_DEAL_SEED_DEV_OPERATOR=1

# --- Demo seed (tools/seed-demo.php) ---
# Shared password for the demo accounts the seed upserts. Optional in
# local/test (defaults to "deal-demo"); REQUIRED in production — the seed
# refuses to run there without it (fail-close). See docs/demo.md.
NENE_DEAL_DEMO_PASSWORD=

# --- Tenancy ---
# Authenticated requests resolve their organization from the signed `org`
# claim of the bearer token. Header-only clients may select one via
# X-Organization-Slug; with exactly one organization provisioned the header
# may be omitted (single-tenant convenience — note that enabling the
# disposable demo makes organizations plural).

# --- Disposable demo (GET /demo/{template}, NENE2 Nene2\Demo — #69) ---
# Strict opt-in (only 1/true/yes enable it; anything else keeps the endpoint
# a plain 404, fail-close). Each visit provisions a throwaway `demo-…` org,
# seeds the presentation pipeline and seats a logged-in session; the sweep
# cron (tools/sweep-demo.php, hourly) destroys demo orgs after the TTL.
# Remaining knobs default to the fleet values (prefix demo- / TTL 3h /
# ceiling 200 orgs / 5 slug attempts) — see vendor NENE2 .env.example.
DEMO_MODE=
# DEMO_SLUG_PREFIX=demo-
# DEMO_TTL_HOURS=3
# DEMO_MAX_ORGS=200
# DEMO_SLUG_ATTEMPTS=5

# Cookieless demo analytics (#112). Set ONLY on the hosted demo deployment, to a
# bare https origin of a self-hosted GoatCounter (e.g. https://stats.example.com;
# no trailing slash, no path). The SPA shell then server-side injects the beacon
# and emits a demo-only CSP allowing that origin. MUST stay empty in this
# template and in any OSS/self-hosted install: an empty (or malformed) value
# means the served shell is byte-identical to the built artifact and carries zero
# telemetry. Never bake the beacon into the committed frontend build.
DEMO_ANALYTICS_ENDPOINT=

# --- Won → Invoice handoff (docs/integrations/invoice-handoff-contract.md) ---
# Set when enabling the operator-confirmed handoff to NeNe Invoice.
# Secrets must never be committed.
NENE_DEAL_INVOICE_BASE_URL=
NENE_DEAL_INVOICE_BEARER_TOKEN=

# --- Database (host / local default: SQLite file under var/) ---
DB_ADAPTER=sqlite
DB_NAME=var/nene_deal.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nene_deal
DB_PASSWORD=
DB_CHARSET=utf8mb4
