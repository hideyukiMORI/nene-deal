{
    "name": "hideyukimori/nene-deal",
    "description": "NeNe Deal — ultra-light self-hosted B2B deal pipeline (kanban, forecast, won → Invoice handoff) on NENE2.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1 <9.0",
        "hideyukimori/nene2": "^1.11",
        "psr/http-client": "^1.0",
        "robmorgan/phinx": "^0.16.11",
        "symfony/http-client": "^8.1",
        "symfony/uid": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "NeneDeal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeneDeal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite NeneDeal",
        "analyse": "phpstan analyse --memory-limit 512M",
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "openapi": "php tools/validate-openapi.php",
        "mcp": "php vendor/hideyukimori/nene2/tools/validate-mcp-tools.php --root=.",
        "conformance": "php vendor/hideyukimori/nene2/tools/conformance.php --root=.",
        "migrations:status": "phinx status -c phinx.php",
        "migrations:migrate": "phinx migrate -c phinx.php",
        "migrations:rollback": "phinx rollback -c phinx.php",
        "check": [
            "@test",
            "@analyse",
            "@cs",
            "@openapi",
            "@mcp",
            "@conformance"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "symfony/yaml": "^8.1"
    }
}
