{
    "name": "hideyukimori/nene-deal",
    "description": "NeNe Deal — ultra-light self-hosted B2B deal pipeline (kanban, forecast, won → Invoice handoff) on NENE2.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1 <9.0",
        "hideyukimori/nene2": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "NeneDeal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeneDeal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite NeneDeal",
        "analyse": "phpstan analyse --memory-limit 512M",
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "check": [
            "@test",
            "@analyse",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1"
    }
}
